{
  "datasets": [
    {
      "name": "c68928fc",
      "displayName": "kpis_generales",
      "queryLines": [
        "SELECT\r\n",
        "  (SELECT COUNT(*) FROM catalog_prod.golden.segmentacion_clientes) AS clientes,\r\n",
        "  (SELECT SUM(total_pedidos) FROM catalog_prod.golden.kpi_habitos_compra) AS pedidos,\r\n",
        "  (SELECT SUM(total_items) FROM catalog_prod.golden.kpi_departamentos) AS productos_vendidos,\r\n",
        "  (SELECT ROUND(SUM(total_recompras) / SUM(total_items) * 100, 1) FROM catalog_prod.golden.kpi_departamentos) AS tasa_recompra_pct\r\n"
      ]
    },
    {
      "name": "971ad347",
      "displayName": "ventas_departamento",
      "queryLines": [
        "SELECT department,\r\n",
        "       SUM(total_items) AS productos_vendidos,\r\n",
        "       ROUND(SUM(total_recompras) / SUM(total_items) * 100, 1) AS tasa_recompra_pct\r\n",
        "FROM catalog_prod.golden.kpi_departamentos\r\n",
        "GROUP BY department\r\n",
        "ORDER BY productos_vendidos DESC"
      ]
    },
    {
      "name": "68a5375c",
      "displayName": "habitos_compra",
      "queryLines": [
        "SELECT CONCAT(order_dow, ' - ', dia_semana) AS dia_semana,\r\n",
        "       order_hour_of_day, franja_horaria, total_pedidos\r\n",
        "FROM catalog_prod.golden.kpi_habitos_compra"
      ]
    },
    {
      "name": "c15b968c",
      "displayName": "top_productos",
      "queryLines": [
        "SELECT ranking, product_name, department, veces_recomprado, ROUND(tasa_recompra * 100, 1) AS tasa_recompra_pct\r\n",
        "FROM catalog_prod.golden.top_productos_recompra\r\n",
        "WHERE ranking <= 15\r\n",
        "ORDER BY ranking"
      ]
    },
    {
      "name": "972be978",
      "displayName": "segmentos_clientes",
      "queryLines": [
        "SELECT segmento,\r\n",
        "       COUNT(*) AS clientes,\r\n",
        "       ROUND(AVG(total_pedidos), 1) AS promedio_pedidos,\r\n",
        "       ROUND(AVG(promedio_dias_entre_pedidos), 1) AS cada_cuantos_dias\r\n",
        "FROM catalog_prod.golden.segmentacion_clientes\r\n",
        "GROUP BY segmento"
      ]
    }
  ],
